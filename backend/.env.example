# ResearchPilot Backend Environment Configuration
# Copy this file to backend/.env and provide your actual credentials.
# NEVER commit .env to version control.

# ==============================================================================
# LLM Provider Configuration
# Supported providers: "gemini", "openai"
# ==============================================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative LLM Provider Keys (optional)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# Web Search Engine (Tavily)
# ==============================================================================
TAVILY_API_KEY=your_tavily_api_key_here

# ==============================================================================
# CORS & Server Settings
# ==============================================================================
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==============================================================================
# Research Execution Limits & Timeouts
# ==============================================================================
REQUEST_TIMEOUT_SECONDS=15.0
MAX_SEARCH_QUERIES=3
MAX_SOURCES=5
LOG_LEVEL=INFO
